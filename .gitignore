# Byte-compiled / cached Python
*.py[cod]
__pycache__/
*.so

# Build, dist, packaging artifacts
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/
wheelhouse/

# Virtual environments
.venv/
venv/
pyvenv*/
.env
.envrc

# Test, coverage, and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/

# Editor and OS junk
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# Sphinx and sphinx-gallery outputs
docs/_build/
docs/sg_execution_times.rst

# uv (no lockfile is committed; cached envs may exist)
.uv-cache/

# Local experiment outputs (example users keep raw data and trained models out of git)
examples/**/*.pkl
examples/**/*.pt
examples/**/*.joblib
examples/data/raw/**
examples/data/interim/**
examples/data/processed/**
!examples/data/raw/.gitkeep
!examples/data/interim/.gitkeep
!examples/data/processed/.gitkeep

# Submission files generated by the CLI
submission*.csv
